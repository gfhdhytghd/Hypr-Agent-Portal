#!/usr/bin/env python3
"""Run applications in a disposable nested Hyprland test session.

This is process/environment isolation for tests, not a security sandbox.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import selectors
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from typing import Any
import uuid


MARKER_NAME = ".hypr-agent-portal-sandbox.json"
LOCK_NAME = ".hypr-agent-portal-sandbox.lock"
MANAGED_DIRS = ("home", "config", "cache", "state", "data", "logs")
SESSION_KEYS = (
    "HOME",
    "XDG_RUNTIME_DIR",
    "XDG_CONFIG_HOME",
    "XDG_CACHE_HOME",
    "XDG_STATE_HOME",
    "XDG_DATA_HOME",
    "WAYLAND_DISPLAY",
    "HYPRLAND_INSTANCE_SIGNATURE",
    "DBUS_SESSION_BUS_ADDRESS",
)


class SandboxError(RuntimeError):
    pass


class SandboxSignal(SandboxError):
    def __init__(self, signum: int):
        super().__init__(f"received signal {signum}")
        self.signum = signum


def emit(payload: dict[str, Any], *, json_output: bool) -> None:
    if json_output:
        print(json.dumps(payload, indent=2, sort_keys=True), flush=True)
        return
    for key, value in payload.items():
        if isinstance(value, (dict, list)):
            print(f"{key}: {json.dumps(value, sort_keys=True)}", flush=True)
        else:
            print(f"{key}: {value}", flush=True)


def command_path(name: str) -> str | None:
    return shutil.which(name)


def parent_wayland_socket() -> Path | None:
    display = os.environ.get("WAYLAND_DISPLAY")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not display:
        return None
    path = Path(display) if os.path.isabs(display) else Path(runtime or "") / display
    try:
        mode = path.stat().st_mode
    except OSError:
        return None
    return path.resolve() if stat.S_ISSOCK(mode) else None


def choose_backend(requested: str) -> tuple[str, Path | None]:
    parent = parent_wayland_socket()
    if requested == "nested":
        if parent is None:
            raise SandboxError("nested backend requested, but the current WAYLAND_DISPLAY is not a live Unix socket")
        return requested, parent
    if requested == "headless":
        return requested, None
    return ("nested", parent) if parent is not None else ("headless", None)


def dependency_report(backend: str) -> dict[str, Any]:
    selected, parent = choose_backend(backend)
    commands = {name: command_path(name) for name in ("Hyprland", "dbus-daemon", "hyprctl")}
    required_ok = bool(commands["Hyprland"] and commands["dbus-daemon"])
    backend_ok = selected == "headless" or parent is not None
    return {
        "ok": required_ok and backend_ok,
        "backend": selected,
        "commands": commands,
        "parentWaylandSocket": str(parent) if parent else None,
        "notes": [
            "nested mode requires a live parent Wayland compositor with linux-dmabuf support",
            "headless mode still requires a usable render device/driver and is validated only when run",
            "this runner isolates HOME/XDG/DBus state but is not a privilege or network sandbox",
        ],
    }


def validate_dimensions(width: int, height: int, refresh: int) -> None:
    if not 320 <= width <= 16384 or not 240 <= height <= 16384:
        raise SandboxError("width and height must be within 320x240 and 16384x16384")
    if not 1 <= refresh <= 1000:
        raise SandboxError("refresh must be between 1 and 1000 Hz")


def validate_fragment(path: Path) -> str:
    try:
        if not path.is_file():
            raise SandboxError(f"config fragment is not a regular file: {path}")
        return path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SandboxError(f"cannot read config fragment {path}: {exc}") from exc


def generated_config(args: argparse.Namespace) -> str:
    lines = [
        "# Generated by hypr-agent-portal-sandbox; does not source host configuration.",
        f"monitor = ,{args.width}x{args.height}@{args.refresh},0x0,1",
        "animations {",
        "  enabled = false",
        "}",
        "misc {",
        "  disable_hyprland_logo = true",
        "  disable_splash_rendering = true",
        "  force_default_wallpaper = 0",
        "}",
        "debug {",
        "  disable_logs = false",
        "  enable_stdout_logs = false",
        "}",
        "xwayland {",
        f"  enabled = {'true' if args.xwayland else 'false'}",
        "}",
    ]
    for plugin in args.plugin:
        resolved = Path(plugin).expanduser().resolve()
        if not resolved.is_file():
            raise SandboxError(f"plugin is not a regular file: {resolved}")
        lines.append(f"plugin = {resolved}")
    for fragment in args.config_fragment:
        text = validate_fragment(Path(fragment).expanduser().resolve())
        lines.extend(("", f"# Begin fragment: {fragment}", text, f"# End fragment: {fragment}"))
    return "\n".join(lines) + "\n"


def validate_session_target(root: Path) -> None:
    resolved = root.resolve()
    home = Path.home().resolve()
    repository = Path(__file__).resolve().parents[1]
    cwd = Path.cwd().resolve()
    protected = {Path("/"), Path("/tmp"), Path("/var/tmp"), Path("/home"), Path("/run"), home, repository}
    for name in ("XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME", "XDG_DATA_HOME", "XDG_RUNTIME_DIR"):
        value = os.environ.get(name)
        if value:
            protected.add(Path(value).expanduser().resolve())
    if (
        resolved in protected
        or resolved.parent == resolved
        or resolved == cwd
        or resolved in cwd.parents
        or (resolved / ".git").exists()
        or (resolved / ".hg").exists()
        or os.path.ismount(resolved)
    ):
        raise SandboxError(f"refusing unsafe session directory: {root}")
    if root.exists():
        metadata = root.lstat()
        if root.is_symlink() or not root.is_dir() or metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
            raise SandboxError(f"refusing unsafe session directory ownership or permissions: {root}")


def safe_session_root(explicit: str | None, *, dry_run: bool, reuse: bool) -> tuple[Path, bool]:
    if explicit:
        root = Path(explicit).expanduser().absolute()
        validate_session_target(root)
        if root.exists() and not root.is_dir():
            raise SandboxError(f"session directory is not a directory: {root}")
        if root.exists() and any(root.iterdir()):
            if not reuse:
                raise SandboxError(f"session directory must be absent or empty unless --reuse is set: {root}")
            data = checked_marker(root, require_stopped=True)
            validate_managed_layout(root, data)
        if not dry_run:
            root.mkdir(mode=0o700, parents=True, exist_ok=True)
        return root, False
    if dry_run:
        return Path("/tmp/hap-sb.<random>"), True
    # Keep runtime paths short: Hyprland IPC uses sockaddr_un and has a strict path limit.
    return Path(tempfile.mkdtemp(prefix="hap-sb.", dir="/tmp")), True


def create_layout(root: Path) -> dict[str, Path]:
    paths = {name: root / name for name in MANAGED_DIRS}
    # This lives outside root intentionally. Hyprland appends a long instance
    # signature and socket name, so even a normal session root can exceed the
    # sockaddr_un limit and silently lose socket2 IPC.
    runtime: Path | None = None
    try:
        runtime = Path(tempfile.mkdtemp(prefix="hp.", dir="/tmp"))
        paths["runtime"] = runtime
        for path in paths.values():
            path.mkdir(mode=0o700, parents=True, exist_ok=True)
            path.chmod(0o700)
        root.chmod(0o700)
        return paths
    except Exception:
        if runtime is not None:
            shutil.rmtree(runtime, ignore_errors=True)
        raise


def acquire_session_lock(root: Path):
    lock = (root / LOCK_NAME).open("a+", encoding="utf-8")
    os.chmod(root / LOCK_NAME, 0o600)
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        lock.close()
        raise SandboxError(f"session directory is already in use: {root}") from exc
    return lock


def install_signal_handlers() -> dict[signal.Signals, Any]:
    previous: dict[signal.Signals, Any] = {}

    def handle(signum: int, _frame: Any) -> None:
        raise SandboxSignal(signum)

    for signum in (signal.SIGTERM, signal.SIGHUP):
        previous[signum] = signal.getsignal(signum)
        signal.signal(signum, handle)
    return previous


def restore_signal_handlers(previous: dict[signal.Signals, Any]) -> None:
    for signum, handler in previous.items():
        signal.signal(signum, handler)


def marker_payload(
    root: Path,
    backend: str,
    status: str,
    runtime: Path | None = None,
    *,
    root_kind: str,
) -> dict[str, Any]:
    payload = {
        "format": 1,
        "ownerUid": os.getuid(),
        "root": str(root.resolve()),
        "backend": backend,
        "status": status,
        "rootKind": root_kind,
        "runnerPid": os.getpid(),
        "runnerStartTime": process_start_time(os.getpid()),
        "updatedAt": time.time(),
    }
    if runtime is not None:
        payload["runtimeDir"] = str(runtime)
    return payload


def write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def isolated_environment(paths: dict[str, Path], backend: str, parent: Path | None) -> dict[str, str]:
    env = dict(os.environ)
    for key in SESSION_KEYS + ("DISPLAY",):
        env.pop(key, None)
    env.update(
        {
            "HOME": str(paths["home"]),
            "XDG_RUNTIME_DIR": str(paths["runtime"]),
            "XDG_CONFIG_HOME": str(paths["config"]),
            "XDG_CACHE_HOME": str(paths["cache"]),
            "XDG_STATE_HOME": str(paths["state"]),
            "XDG_DATA_HOME": str(paths["data"]),
            "XDG_SESSION_TYPE": "wayland",
            "XDG_CURRENT_DESKTOP": "Hyprland",
            "XDG_SESSION_DESKTOP": "Hyprland",
            "HYPRLAND_NO_SD_VARS": "1",
            "NO_AT_BRIDGE": "0",
        }
    )
    if backend == "nested" and parent is not None:
        env["WAYLAND_DISPLAY"] = str(parent)
    return env


def start_dbus(env: dict[str, str], log_path: Path) -> tuple[subprocess.Popen[str], str]:
    bus_path = Path(env["XDG_RUNTIME_DIR"]) / "bus"
    try:
        log_handle = log_path.open("w", encoding="utf-8")
        proc = subprocess.Popen(
            [
                "dbus-daemon",
                "--session",
                f"--address=unix:path={bus_path}",
                "--nofork",
                "--nopidfile",
                "--print-address=1",
            ],
            env=env,
            text=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=log_handle,
            start_new_session=True,
        )
        log_handle.close()
    except Exception:
        try:
            log_handle.close()
        except (NameError, OSError):
            pass
        raise
    selector = selectors.DefaultSelector()
    try:
        if proc.stdout is None:
            raise SandboxError("dbus-daemon did not expose its address pipe")
        selector.register(proc.stdout, selectors.EVENT_READ)
        if not selector.select(timeout=10):
            raise SandboxError("isolated dbus-daemon did not publish an address within 10 seconds")
        address = proc.stdout.readline().strip()
        if not address.startswith("unix:path=") or proc.poll() is not None:
            raise SandboxError(f"isolated dbus-daemon returned an invalid address: {address!r}")
        return proc, address
    except Exception:
        terminate_group(proc)
        raise
    finally:
        selector.close()


def process_stat(pid: int) -> tuple[str, int, int] | None:
    try:
        stat_line = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        fields = stat_line[stat_line.rfind(") ") + 2 :].split()
        return fields[0], int(fields[2]), int(fields[19])
    except (OSError, ValueError, IndexError):
        return None


def process_is_running(pid: int) -> bool:
    stat_record = process_stat(pid)
    return stat_record is not None and stat_record[0] not in {"Z", "X"}


def process_start_time(pid: int) -> int | None:
    stat_record = process_stat(pid)
    if stat_record is None or stat_record[0] in {"Z", "X"}:
        return None
    return stat_record[2]


def process_matches(pid: object, start_time: object) -> bool:
    return isinstance(pid, int) and isinstance(start_time, int) and process_start_time(pid) == start_time


def marked_processes(marker: str, variable: str = "HYPR_AGENT_PORTAL_SANDBOX_ID") -> list[int]:
    needle = f"{variable}={marker}".encode()
    matches: list[int] = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            environment = (entry / "environ").read_bytes().split(b"\0")
        except (OSError, PermissionError):
            continue
        if needle in environment:
            matches.append(int(entry.name))
    return matches


def terminate_marked_processes(
    marker: str,
    timeout: float = 3.0,
    variable: str = "HYPR_AGENT_PORTAL_SANDBOX_ID",
) -> list[int]:
    pids = marked_processes(marker, variable)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            try:
                os.kill(pid, sig)
            except (ProcessLookupError, PermissionError):
                pass
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            pids = marked_processes(marker, variable)
            if not pids:
                return []
            time.sleep(0.05)
    return marked_processes(marker, variable)


def process_group_exists(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    saw_member = False
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        stat_record = process_stat(int(entry.name))
        if stat_record is None or stat_record[1] != pgid:
            continue
        saw_member = True
        if stat_record[0] not in {"Z", "X"}:
            return True
    # killpg confirmed the group exists. Only report it gone when /proc showed
    # that every remaining member is a non-runnable zombie/dead task.
    return not saw_member


def wait_for_group_exit(pgid: int, timeout: float, proc: subprocess.Popen[Any] | None = None) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if proc is not None:
            proc.poll()
        if not process_group_exists(pgid):
            return True
        time.sleep(0.05)
    if proc is not None:
        proc.poll()
    return not process_group_exists(pgid)


def terminate_recorded_group(pid: object, start_time: object, timeout: float = 5.0) -> bool:
    if not process_matches(pid, start_time):
        return True
    assert isinstance(pid, int)
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    if wait_for_group_exit(pid, timeout):
        return True
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    return wait_for_group_exit(pid, 2.0)


def terminate_group(proc: subprocess.Popen[Any] | None, timeout: float = 5.0) -> bool:
    # Once the leader has exited, its numeric PGID may be reused by an
    # unrelated session. Descendants are recovered by their unguessable
    # environment marker instead of signaling an unverifiable group.
    if proc is None or proc.poll() is not None or not process_group_exists(proc.pid):
        return True
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    if wait_for_group_exit(proc.pid, timeout, proc):
        proc.poll()
        return True
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    exited = wait_for_group_exit(proc.pid, 2.0, proc)
    proc.poll()
    return exited


def normalized_returncode(returncode: int | None) -> int:
    if returncode is None:
        return 0
    return 128 + -returncode if returncode < 0 else returncode


def wait_for_hyprland(proc: subprocess.Popen[Any], runtime: Path, timeout: float) -> tuple[str, str]:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        returncode = proc.poll()
        if returncode is not None:
            raise SandboxError(f"Hyprland exited before readiness with status {returncode}")
        for lock in runtime.glob("hypr/*/hyprland.lock"):
            try:
                lines = lock.read_text(encoding="utf-8").splitlines()
            except OSError:
                continue
            if len(lines) < 2:
                continue
            try:
                lock_pid = int(lines[0])
            except ValueError:
                continue
            display = lines[1].strip()
            socket_path = runtime / display
            if lock_pid == proc.pid and display and socket_path.exists():
                return lock.parent.name, display
        time.sleep(0.05)
    raise SandboxError(f"Hyprland did not publish a Wayland socket within {timeout:g} seconds")


def write_env_file(path: Path, env: dict[str, str]) -> None:
    export_keys = SESSION_KEYS + ("HYPR_AGENT_PORTAL_SANDBOX_ID",)
    exported = [f"export {key}={shlex.quote(env[key])}" for key in export_keys if key in env]
    path.write_text("\n".join(exported) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)


def tail_log(path: Path, line_count: int = 40) -> str:
    try:
        return "\n".join(path.read_text(encoding="utf-8", errors="replace").splitlines()[-line_count:])
    except OSError:
        return ""


def run_session(args: argparse.Namespace) -> int:
    validate_dimensions(args.width, args.height, args.refresh)
    report = dependency_report(args.backend)
    backend = str(report["backend"])
    parent = Path(report["parentWaylandSocket"]) if report["parentWaylandSocket"] else None
    config = generated_config(args)
    if not report["ok"] and not args.dry_run:
        raise SandboxError("required dependencies are unavailable; run the doctor subcommand for details")
    root, temporary_root = safe_session_root(args.session_dir, dry_run=args.dry_run, reuse=args.reuse)
    root_kind = "temporary" if temporary_root else "explicit"
    keep = args.keep or not temporary_root
    plan = {
        "ok": bool(report["ok"]),
        "action": "run",
        "backend": backend,
        "sessionDir": str(root),
        "persistent": keep,
        "parentWaylandSocket": str(parent) if parent else None,
        "command": args.command or None,
        "plugins": [str(Path(p).expanduser().resolve()) for p in args.plugin],
        "config": config,
        "diagnostics": report,
    }
    if args.dry_run:
        emit(plan, json_output=args.json)
        return 0

    previous_signal_handlers = install_signal_handlers()
    try:
        session_lock = acquire_session_lock(root)
    except Exception:
        restore_signal_handlers(previous_signal_handlers)
        if temporary_root:
            shutil.rmtree(root, ignore_errors=True)
        raise
    try:
        paths = create_layout(root)
    except Exception:
        session_lock.close()
        restore_signal_handlers(previous_signal_handlers)
        if temporary_root:
            shutil.rmtree(root, ignore_errors=True)
        raise
    marker_path = root / MARKER_NAME
    config_path = root / "hyprland.conf"
    env = isolated_environment(paths, backend, parent)
    session_marker = uuid.uuid4().hex
    env["HYPR_AGENT_PORTAL_SANDBOX_ID"] = session_marker
    dbus: subprocess.Popen[str] | None = None
    hyprland: subprocess.Popen[Any] | None = None
    app: subprocess.Popen[Any] | None = None
    hypr_log_path = paths["logs"] / "hyprland.console.log"
    try:
        starting = marker_payload(root, backend, "starting", paths["runtime"], root_kind=root_kind)
        starting["sessionMarker"] = session_marker
        write_json_atomic(marker_path, starting)
        config_path.write_text(config, encoding="utf-8")
        os.chmod(config_path, 0o600)
        dbus, bus_address = start_dbus(env, paths["logs"] / "dbus.log")
        env["DBUS_SESSION_BUS_ADDRESS"] = bus_address
        with hypr_log_path.open("w", encoding="utf-8") as log_handle:
            hyprland = subprocess.Popen(
                ["Hyprland", "--config", str(config_path)],
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                text=True,
            )
        instance, display = wait_for_hyprland(hyprland, paths["runtime"], args.startup_timeout)
        env["HYPRLAND_INSTANCE_SIGNATURE"] = instance
        env["WAYLAND_DISPLAY"] = display
        write_env_file(root / "session.env", env)
        active = marker_payload(root, backend, "active", paths["runtime"], root_kind=root_kind)
        active.update(
            {
                "sessionMarker": session_marker,
                "hyprlandPid": hyprland.pid,
                "hyprlandStartTime": process_start_time(hyprland.pid),
                "dbusPid": dbus.pid,
                "dbusStartTime": process_start_time(dbus.pid),
                "waylandDisplay": display,
                "instance": instance,
            }
        )
        write_json_atomic(marker_path, active)
        ready_payload = {
            "ok": True,
            "status": "ready",
            "backend": backend,
            "sessionDir": str(root),
            "waylandDisplay": display,
            "instance": instance,
            "envFile": str(root / "session.env"),
        }
        if args.command and args.json:
            ready_payload["applicationStdout"] = str(paths["logs"] / "app.stdout.log")
            ready_payload["applicationStderr"] = str(paths["logs"] / "app.stderr.log")
        emit(ready_payload, json_output=args.json)

        started = time.monotonic()
        if args.command:
            app_marker = uuid.uuid4().hex
            app_env = dict(env)
            app_env["HYPR_AGENT_PORTAL_SANDBOX_APP_ID"] = app_marker
            active["appMarker"] = app_marker
            app_stdout = None
            app_stderr = None
            if args.json:
                app_stdout = (paths["logs"] / "app.stdout.log").open("w", encoding="utf-8")
                app_stderr = (paths["logs"] / "app.stderr.log").open("w", encoding="utf-8")
            try:
                app = subprocess.Popen(args.command, env=app_env, start_new_session=True, stdout=app_stdout, stderr=app_stderr)
            finally:
                if app_stdout is not None:
                    app_stdout.close()
                if app_stderr is not None:
                    app_stderr.close()
            active["appPid"] = app.pid
            active["appStartTime"] = process_start_time(app.pid)
            write_json_atomic(marker_path, active)
            while app.poll() is None:
                if hyprland.poll() is not None:
                    raise SandboxError(f"Hyprland exited while the application was running (status {hyprland.returncode})")
                if args.timeout and time.monotonic() - started >= args.timeout:
                    raise SandboxError(f"session timeout reached after {args.timeout:g} seconds")
                time.sleep(0.05)
            return normalized_returncode(app.returncode)

        while hyprland.poll() is None:
            if args.timeout and time.monotonic() - started >= args.timeout:
                return 0
            time.sleep(0.1)
        raise SandboxError(f"Hyprland exited unexpectedly with status {hyprland.returncode}")
    except KeyboardInterrupt:
        return 130
    except SandboxSignal as exc:
        return 128 + exc.signum
    except SandboxError:
        log_tail = tail_log(hypr_log_path)
        if log_tail:
            print("Hyprland log tail:\n" + log_tail, file=sys.stderr)
        raise
    finally:
        for signum in previous_signal_handlers:
            signal.signal(signum, signal.SIG_IGN)
        cleanup_failures: list[str] = []
        if not terminate_group(app):
            cleanup_failures.append(f"app-pgid:{app.pid if app else 'unknown'}")
        if not terminate_group(hyprland):
            cleanup_failures.append(f"hyprland-pgid:{hyprland.pid if hyprland else 'unknown'}")
        if "app_marker" in locals():
            cleanup_failures.extend(
                f"app-pid:{pid}"
                for pid in terminate_marked_processes(app_marker, variable="HYPR_AGENT_PORTAL_SANDBOX_APP_ID")
            )
        if not terminate_group(dbus):
            cleanup_failures.append(f"dbus-pgid:{dbus.pid if dbus else 'unknown'}")
        cleanup_failures.extend(f"session-pid:{pid}" for pid in terminate_marked_processes(session_marker))
        if not cleanup_failures:
            try:
                ensure_no_nested_mounts(root)
                ensure_no_nested_mounts(paths["runtime"])
            except SandboxError as exc:
                cleanup_failures.append(str(exc))
        if marker_path.exists():
            status = "cleanup_failed" if cleanup_failures else "stopped"
            try:
                stopped = json.loads(marker_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                stopped = marker_payload(root, backend, status, paths["runtime"], root_kind=root_kind)
            stopped.update(
                {
                    "status": status,
                    "updatedAt": time.time(),
                    "runtimeDir": str(paths["runtime"]),
                    "rootKind": root_kind,
                    "sessionMarker": session_marker,
                }
            )
            if cleanup_failures:
                stopped["remainingProcesses"] = cleanup_failures
            else:
                stopped.pop("remainingProcesses", None)
            write_json_atomic(marker_path, stopped)
        if cleanup_failures:
            print(f"sandbox cleanup incomplete; artifacts retained at {root}", file=sys.stderr)
        else:
            shutil.rmtree(paths["runtime"], ignore_errors=True)
            if not keep:
                shutil.rmtree(root, ignore_errors=True)
            else:
                print(f"sandbox artifacts retained at {root}", file=sys.stderr)
        session_lock.close()
        restore_signal_handlers(previous_signal_handlers)
        if cleanup_failures:
            raise SandboxError("sandbox cleanup left processes running: " + ", ".join(cleanup_failures))


def checked_marker(root: Path, *, require_stopped: bool = False) -> dict[str, Any]:
    marker = root / MARKER_NAME
    try:
        data = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SandboxError(f"refusing cleanup: valid {MARKER_NAME} not found in {root}") from exc
    if data.get("format") != 1 or data.get("ownerUid") != os.getuid() or data.get("rootKind") not in {"temporary", "explicit"}:
        raise SandboxError("refusing cleanup: marker format or owner does not match")
    if Path(str(data.get("root", ""))).resolve() != root.resolve():
        raise SandboxError("refusing cleanup: marker root does not match the requested directory")
    runner_pid = data.get("runnerPid")
    if process_matches(runner_pid, data.get("runnerStartTime")):
        raise SandboxError(f"refusing cleanup: sandbox runner process {runner_pid} is still active")
    if require_stopped and data.get("status") != "stopped":
        raise SandboxError(f"refusing reuse: session status is {data.get('status')!r}, expected 'stopped'")
    return data


def nested_mounts(root: Path) -> list[Path]:
    try:
        root_device = root.lstat().st_dev
        parent_device = root.parent.stat().st_dev
    except OSError as exc:
        raise SandboxError(f"cannot inspect cleanup root: {root}") from exc
    found: list[Path] = [root] if os.path.ismount(root) or root_device != parent_device else []
    stack = [root]
    while stack:
        current = stack.pop()
        try:
            entries = tuple(os.scandir(current))
        except OSError as exc:
            raise SandboxError(f"cannot inspect cleanup tree: {current}") from exc
        for entry in entries:
            try:
                if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                    continue
                path = Path(entry.path)
                metadata = entry.stat(follow_symlinks=False)
            except OSError as exc:
                raise SandboxError(f"cannot inspect cleanup entry: {entry.path}") from exc
            if metadata.st_dev != root_device or os.path.ismount(path):
                found.append(path)
            else:
                stack.append(path)
    return found


def ensure_no_nested_mounts(root: Path) -> None:
    mounts = nested_mounts(root)
    if mounts:
        raise SandboxError("refusing cleanup across nested mounts: " + ", ".join(str(path) for path in mounts))


def validate_managed_layout(root: Path, data: dict[str, Any]) -> None:
    if data.get("rootKind") == "temporary":
        resolved = root.resolve()
        if resolved.parent != Path("/tmp") or not resolved.name.startswith("hap-sb."):
            raise SandboxError(f"refusing cleanup: invalid temporary session root {root}")
    for name in MANAGED_DIRS:
        path = root / name
        try:
            metadata = path.lstat()
        except OSError as exc:
            raise SandboxError(f"refusing cleanup: managed directory is missing: {path}") from exc
        if path.is_symlink() or not path.is_dir() or metadata.st_uid != os.getuid():
            raise SandboxError(f"refusing cleanup: unsafe managed directory: {path}")
    for name in (MARKER_NAME, LOCK_NAME):
        path = root / name
        metadata = path.lstat()
        if path.is_symlink() or not path.is_file() or metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
            raise SandboxError(f"refusing cleanup: unsafe managed file: {path}")
    for name in ("hyprland.conf", "session.env"):
        path = root / name
        if not path.exists():
            continue
        metadata = path.lstat()
        if path.is_symlink() or not path.is_file() or metadata.st_uid != os.getuid():
            raise SandboxError(f"refusing cleanup: unsafe managed file: {path}")
    ensure_no_nested_mounts(root)


def remove_managed_session(root: Path, data: dict[str, Any]) -> bool:
    ensure_no_nested_mounts(root)
    if data.get("rootKind") == "temporary":
        shutil.rmtree(root)
        return True
    for name in MANAGED_DIRS:
        shutil.rmtree(root / name)
    for name in (MARKER_NAME, LOCK_NAME, "hyprland.conf", "session.env"):
        path = root / name
        if not path.exists():
            continue
        metadata = path.lstat()
        if path.is_symlink() or not path.is_file() or metadata.st_uid != os.getuid():
            raise SandboxError(f"refusing cleanup: unsafe managed file: {path}")
        path.unlink()
    try:
        root.rmdir()
        return True
    except OSError:
        return False


def remove_recorded_runtime(data: dict[str, Any]) -> None:
    value = data.get("runtimeDir")
    if not isinstance(value, str):
        return
    runtime = Path(value)
    try:
        resolved = runtime.resolve()
        metadata = runtime.lstat()
    except OSError:
        return
    if resolved.parent != Path("/tmp") or not resolved.name.startswith("hp.") or metadata.st_uid != os.getuid():
        raise SandboxError(f"refusing unsafe recorded runtime directory: {runtime}")
    if runtime.is_symlink() or not runtime.is_dir():
        raise SandboxError(f"refusing non-directory recorded runtime: {runtime}")
    ensure_no_nested_mounts(runtime)
    shutil.rmtree(runtime)


def cleanup_session(args: argparse.Namespace) -> int:
    root = Path(args.session_dir).expanduser().absolute()
    validate_session_target(root)
    data = checked_marker(root)
    validate_managed_layout(root, data)
    if args.dry_run:
        emit(
            {
                "ok": True,
                "action": "cleanup",
                "sessionDir": str(root),
                "wouldRemove": True,
                "recordedRuntime": data.get("runtimeDir"),
            },
            json_output=args.json,
        )
        return 0
    session_lock = acquire_session_lock(root)
    cleanup_signal_handlers = {signum: signal.getsignal(signum) for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    for signum in cleanup_signal_handlers:
        signal.signal(signum, signal.SIG_IGN)
    try:
        data = checked_marker(root)
        validate_managed_layout(root, data)
        remaining: list[str] = []
        app_marker = data.get("appMarker")
        if isinstance(app_marker, str):
            remaining.extend(
                f"app-pid:{pid}"
                for pid in terminate_marked_processes(app_marker, variable="HYPR_AGENT_PORTAL_SANDBOX_APP_ID")
            )
        session_marker = data.get("sessionMarker")
        if isinstance(session_marker, str):
            remaining.extend(f"session-pid:{pid}" for pid in terminate_marked_processes(session_marker))
        for label in ("app", "hyprland", "dbus"):
            if not terminate_recorded_group(data.get(f"{label}Pid"), data.get(f"{label}StartTime")):
                remaining.append(f"{label}-pgid:{data.get(f'{label}Pid')}")
        if remaining:
            data["status"] = "cleanup_failed"
            data["remainingProcesses"] = remaining
            data["updatedAt"] = time.time()
            write_json_atomic(root / MARKER_NAME, data)
            raise SandboxError("sandbox cleanup left processes running: " + ", ".join(remaining))
        remove_recorded_runtime(data)
        removed = remove_managed_session(root, data)
    finally:
        session_lock.close()
        restore_signal_handlers(cleanup_signal_handlers)
    emit(
        {"ok": True, "action": "cleanup", "sessionDir": str(root), "removed": removed, "managedStateRemoved": True},
        json_output=args.json,
    )
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="subcommand", required=True)

    doctor = sub.add_parser("doctor", help="report dependencies and selected backend without starting anything")
    doctor.add_argument("--backend", choices=("auto", "nested", "headless"), default="auto")
    doctor.add_argument("--json", action="store_true")

    run = sub.add_parser("run", help="start an isolated Hyprland session and optionally launch one command")
    run.add_argument("--backend", choices=("auto", "nested", "headless"), default="auto")
    run.add_argument("--session-dir", help="use and retain this new/empty directory instead of a temporary one")
    run.add_argument("--reuse", action="store_true", help="reuse a stopped, marked --session-dir and its HOME/XDG state")
    run.add_argument("--keep", action="store_true", help="retain an automatically-created session directory")
    run.add_argument("--dry-run", action="store_true", help="print the plan and generated config without creating files or processes")
    run.add_argument("--json", action="store_true")
    run.add_argument("--width", type=int, default=1280)
    run.add_argument("--height", type=int, default=720)
    run.add_argument("--refresh", type=int, default=60)
    run.add_argument("--startup-timeout", type=float, default=15.0)
    run.add_argument("--timeout", type=float, default=0.0, help="stop after this many seconds; 0 disables the limit")
    run.add_argument("--plugin", action="append", default=[], help="load a plugin .so; repeatable")
    run.add_argument("--config-fragment", action="append", default=[], help="append an explicit config fragment; repeatable")
    run.add_argument("--xwayland", action="store_true", help="enable XWayland inside the isolated session")
    run.add_argument("command", nargs=argparse.REMAINDER, help="command launched after the nested compositor is ready")

    cleanup = sub.add_parser("cleanup", help="remove a retained session after validating its ownership marker")
    cleanup.add_argument("session_dir")
    cleanup.add_argument("--dry-run", action="store_true")
    cleanup.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    if getattr(args, "command", None) and args.command[0] == "--":
        args.command = args.command[1:]
    if getattr(args, "reuse", False) and not args.session_dir:
        parser.error("--reuse requires --session-dir")
    if getattr(args, "startup_timeout", 1) <= 0 or getattr(args, "timeout", 0) < 0:
        parser.error("timeouts must be non-negative, and startup timeout must be positive")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    try:
        if args.subcommand == "doctor":
            report = dependency_report(args.backend)
            emit(report, json_output=args.json)
            return 0 if report["ok"] else 1
        if args.subcommand == "cleanup":
            return cleanup_session(args)
        return run_session(args)
    except (SandboxError, OSError, subprocess.SubprocessError) as exc:
        print(f"hypr-agent-portal-sandbox: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
