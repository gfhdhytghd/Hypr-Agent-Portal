#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import shutil
import stat
from pathlib import Path

from PIL import Image


OFFICIAL_CURSOR_NAME = "official-software-cursor-window-252.png"
DEFAULT_OPEN_CODEX_REFERENCE = Path(
    "/tmp/open-codex-computer-use/docs/references/codex-computer-use-reverse-engineering/"
    "assets/extracted-2026-04-19"
) / OFFICIAL_CURSOR_NAME


def default_output_dir() -> Path:
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    if xdg_config:
        return Path(xdg_config) / "hypr-agent-portal"
    return Path.home() / ".config" / "hypr-agent-portal"


def candidate_sources() -> list[Path]:
    candidates: list[Path] = []
    if DEFAULT_OPEN_CODEX_REFERENCE.exists():
        candidates.append(DEFAULT_OPEN_CODEX_REFERENCE)

    cache_root = Path.home() / ".codex" / "plugins" / "cache"
    if cache_root.exists():
        patterns = [
            f"**/{OFFICIAL_CURSOR_NAME}",
            "**/official-software-cursor-window.png",
            "**/software-cursor*.png",
            "**/SoftwareCursor*.png",
        ]
        for pattern in patterns:
            candidates.extend(sorted(cache_root.glob(pattern)))

    return candidates


def open_default_reference():
    try:
        fd = os.open(DEFAULT_OPEN_CODEX_REFERENCE, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOFOLLOW)
    except OSError:
        return None
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        os.close(fd)
        return None
    return os.fdopen(fd, "rb")


def premultiplied_rgba_bytes(png_source) -> bytes:
    with Image.open(png_source) as png:
        if png.size != (252, 252):
            raise SystemExit(f"cursor PNG is {png.size}, expected 252x252")
        image = png.convert("RGBA")

    output = bytearray()
    data = image.tobytes()
    for offset in range(0, len(data), 4):
        red, green, blue, alpha = data[offset : offset + 4]
        output.extend(
            (
                (red * alpha + 127) // 255,
                (green * alpha + 127) // 255,
                (blue * alpha + 127) // 255,
                alpha,
            )
        )
    return bytes(output)


def main() -> int:
    parser = argparse.ArgumentParser(description="Install the Codex Computer Use cursor texture for hypr-agent-portal.")
    parser.add_argument("source", nargs="?", type=Path, help="official 252x252 cursor PNG to install")
    parser.add_argument("--output-dir", type=Path, default=default_output_dir())
    args = parser.parse_args()

    source = args.source
    owned_reference = None
    if source is None:
        sources = candidate_sources()
        if sources and sources[0] == DEFAULT_OPEN_CODEX_REFERENCE:
            owned_reference = open_default_reference()
            if owned_reference is None:
                sources.pop(0)
        if not sources:
            raise SystemExit("No official cursor PNG found. Pass the extracted 252x252 PNG path explicitly.")
        source = sources[0]

    output_dir = args.output_dir.expanduser()
    output_dir.mkdir(parents=True, exist_ok=True)
    raw_path = output_dir / "codex-cursor-252.abgr"
    png_copy = output_dir / "codex-cursor-252.png"

    with owned_reference if owned_reference is not None else source.open("rb") as stream:
        raw_path.write_bytes(premultiplied_rgba_bytes(stream))
        if not (png_copy.exists() and source.samefile(png_copy)):
            stream.seek(0)
            with png_copy.open("wb") as output:
                shutil.copyfileobj(stream, output)

    print(f"source={source}")
    print(f"raw={raw_path}")
    print(f"png={png_copy}")
    print("hypr-agent-portal will use the raw texture after the plugin is reloaded.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
